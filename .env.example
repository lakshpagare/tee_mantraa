# ---------- Core ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/verano?retryWrites=true&w=majority

# ---------- Auth.js ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to require verified email before password login
REQUIRE_EMAIL_VERIFICATION=false

# ---------- Cloudinary (optional in dev: falls back to /public/uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------- Email (optional; logs to console if empty) ----------
RESEND_API_KEY=
MAIL_FROM="VERANO <no-reply@example.com>"

# ---------- Seed (development only) ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Now-123!
SEED_ADMIN_NAME=Store Admin
