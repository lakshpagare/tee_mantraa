# ---------- Core ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tee-mantraa?retryWrites=true&w=majority

# ---------- Auth.js ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to show the "Continue with Google" button (only after the two values above are set)
NEXT_PUBLIC_GOOGLE_ENABLED=false
# Set to "true" to require verified email before password login
REQUIRE_EMAIL_VERIFICATION=false

# ---------- Cloudinary (optional in dev: falls back to /public/uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------- Email (optional; logs to console if empty) ----------
RESEND_API_KEY=
MAIL_FROM="tee-mantraa <no-reply@example.com>"

# ---------- Seed (development only) ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Now-123!
SEED_ADMIN_NAME=Store Admin

# ---------- Razorpay webhook (Dashboard → Settings → Webhooks → /api/payments/webhook) ----------
RAZORPAY_WEBHOOK_SECRET=

# ---------- Analytics (optional) ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Rate limiting across serverless instances (optional, Upstash Redis REST) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Abandoned-cart cron (Vercel sends this as a Bearer token) ----------
CRON_SECRET=

# ---------- Live Instagram grid (optional long-lived token) ----------
INSTAGRAM_ACCESS_TOKEN=

# ---------- Sentry error tracking (optional; get a DSN at sentry.io → Projects → Client Keys) ----------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed to upload source maps during `next build`:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------- WhatsApp Business Cloud API (optional; see README) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set true to send pre-approved templates (required to message customers outside Meta's 24-hour window)
WHATSAPP_USE_TEMPLATES=false
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_PLACED=order_placed
WHATSAPP_TEMPLATE_SHIPPED=order_shipped
WHATSAPP_TEMPLATE_DELIVERED=order_delivered
WHATSAPP_TEMPLATE_CANCELLED=order_cancelled
WHATSAPP_TEMPLATE_RETURNED=order_returned
